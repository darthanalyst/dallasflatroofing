---
import { site, serviceNav, areaNav } from "../data/site.js";
import { orgNode, websiteNode } from "../lib/schema.js";
const { title, description, path = "/", canonical, transparentHeader = false } = Astro.props;
const canon = canonical || site.url + path;
const sitewide = [orgNode(), websiteNode()];
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canon} />
<link rel="icon" href="/images/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/images/favicon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canon} />
<meta property="og:site_name" content={site.brand} />
<meta property="og:image" content={site.url + "/images/og.jpg"} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="stylesheet" href="/styles.css" />
<script type="application/ld+json" set:html={JSON.stringify(sitewide)} />
<slot name="head" />
</head>
<body class={transparentHeader ? "home" : ""}>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/><path d="M9.5 20v-5h5v5"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26z"/></symbol>
  <symbol id="i-bolt" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></symbol>
  <symbol id="i-building" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V7l7-4 7 4v14"/><path d="M17 11h4v10M3 21h18"/><path d="M7 9v0M7 13v0M7 17v0M13 9v0M13 13v0M13 17v0"/></symbol>
  <symbol id="i-roof" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 5l9 7"/><path d="M5 11v8h14v-8"/><path d="M10 19v-5h4v5"/></symbol>
  <symbol id="i-wrench" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
  <symbol id="i-layers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></symbol>
  <symbol id="i-drop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></symbol>
  <symbol id="i-clipboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></symbol>
  <symbol id="i-roll" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="7" rx="4.5" ry="2.2"/><path d="M3.5 7v6c0 1.2 2 2.2 4.5 2.2s4.5-1 4.5-2.2V7"/><path d="M12.5 12h6.5l2 8H10"/></symbol>
  <symbol id="i-flame" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></symbol>
  <symbol id="i-roller" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="6" x="2" y="2" rx="2"/><path d="M10 16v-2a2 2 0 0 1 2-2h8a2 2 0 0 0 2-2V5"/><rect width="4" height="6" x="8" y="16" rx="1"/></symbol>
</defs></svg>

<div class="utility"><div class="wrap">
  <span class="hours"><svg><use href="#i-pin"/></svg> {site.city}, {site.region} · {site.hoursShort}</span>
  <span>Call <a href={site.phoneHref}>{site.phone}</a></span>
</div></div>

<header class="site-header">
  <nav class="nav wrap">
    <a href="/" class="brand" aria-label={site.brand + " home"}>
      <img class="brand-logo" src="/images/logo.png" width="760" height="218" alt="Dallas Flat Roofing - local flat-roof contractors, Dallas TX" />
    </a>
    <button class="menu-toggle" aria-label="Menu" onclick="document.getElementById('nav').classList.toggle('open')"><svg><use href="#i-menu"/></svg></button>
    <div class="nav-links" id="nav">
      <a href="/">Home</a>
      <div class="has-sub" tabindex="0">
        <a href="/services/" class="sub-toggle">Services ▾</a>
        <div class="submenu">
          {serviceNav.map((s) => <a href={`/${s.slug}/`}>{s.label}</a>)}
        </div>
      </div>
      <div class="has-sub" tabindex="0">
        <a href="/service-areas/" class="sub-toggle">Service Areas ▾</a>
        <div class="submenu">
          <a href="/service-areas/">All of Dallas & DFW</a>
          {areaNav.map((a) => <a href={`/${a.slug}/`}>{a.label}</a>)}
        </div>
      </div>
      <a href="/how-it-works/">How It Works</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a class="nav-call" href={site.phoneHref}><svg><use href="#i-phone"/></svg> {site.phone}</a>
    </div>
  </nav>
</header>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="footer-brand-mark">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="12" fill="#f26a21"/>
          <g fill="none" stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 32 32 19l21 13"/><path d="M16 32v14h32V32"/><path d="M28 46v-9h8v9"/>
          </g>
          <rect x="13" y="28" width="38" height="3.6" rx="1.8" fill="#0a2c54"/>
        </svg>
        <span class="wordmark">Dallas Flat <b>Roofing</b><small>Flat-Roof Specialists · DFW</small></span>
      </div>
      <p>Flat and low-slope roofing across Dallas and the DFW metroplex — TPO, EPDM, PVC, modified bitumen, and built-up, from leak repair to full replacement.</p>
      <a class="footer-call" href={site.phoneHref}><svg><use href="#i-phone"/></svg> {site.phone}</a>
      <p style="margin-top:4px">{site.hoursShort} · {site.city}, {site.region}</p>
      <a class="btn btn-outline" href="/contact/">Contact Us</a>
    </div>
    <div>
      <h4>Flat Roof Services</h4>
      <ul>
        {serviceNav.map((s) => <li><a href={`/${s.slug}/`}>{s.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Service Areas</h4>
      <ul>
        <li><a href="/service-areas/">All Service Areas</a></li>
        {areaNav.map((a) => <li><a href={`/${a.slug}/`}>{a.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/services/">All Services</a></li>
        <li><a href="/how-it-works/">How It Works</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom"><div class="wrap">
    <p class="disclaimer">{site.brand} is a free service to assist homeowners and property owners in connecting with local service providers for flat roofing. All contractors/providers are independent and {site.brand} does not warrant or guarantee any work performed. It is the responsibility of the property owner to verify that the hired contractor furnishes the necessary license and insurance required for the work being performed. All persons depicted in a photo or video are actors or models and not contractors listed on {site.brand}.</p>
    <div class="copyright">© {year} {site.brand}. All rights reserved.</div>
  </div></div>
</footer>

<a class="mobile-call" href={site.phoneHref}><svg><use href="#i-phone"/></svg> Tap to Call · {site.phone}</a>

{transparentHeader && (
  <script is:inline>
    (function () {
      var h = document.querySelector('.site-header');
      if (!h) return;
      var onScroll = function () {
        if (window.scrollY > 40) h.classList.add('scrolled');
        else h.classList.remove('scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
)}

</body>
</html>
