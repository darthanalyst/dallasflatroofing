---
import Base from "../layouts/Base.astro";
import { site, serviceNav } from "../data/site.js";
import { serviceNode, breadcrumb, faqNode } from "../lib/schema.js";
const { service, canonical } = Astro.props;
const path = `/${service.slug}/`;
const related = serviceNav.filter((s) => service.cross.includes(s.slug));
const schemaPath = canonical ? new URL(canonical).pathname : path;
const schema = [
  serviceNode({ name: service.h1, serviceType: service.serviceType, description: service.metaDesc, path: schemaPath }),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Services", path: "/services/" },
    { name: service.crumb, path: schemaPath },
  ]),
];
if (service.faqs && service.faqs.length) schema.push(faqNode(service.faqs));
---
<Base title={service.metaTitle} description={service.metaDesc} path={path} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/services/">Services</a> / {service.crumb}</div></div>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker"><svg style="width:15px;height:15px;vertical-align:-2px;color:var(--gold)"><use href={`#${service.glyph}`}/></svg> {service.kicker}</span>
        <h1>{service.h1}</h1>
        <p class="lead">{service.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-call" href={site.phoneHref}><svg><use href="#i-phone"/></svg> Call {site.phone}</a>
          <span class="tapline">Upfront pricing · No obligation · {site.hoursShort}</span>
        </div>
        <ul class="creds">
          <li><svg><use href="#i-pin"/></svg> Dallas & the DFW metroplex</li>
          <li><svg><use href="#i-roof"/></svg> Flat & low-slope roofs only</li>
          <li><svg><use href="#i-check"/></svg> Inspect, price, repair</li>
        </ul>
      </div>
      <div class="hero-art">
        <img src={service.img} width="800" height="600" alt={service.heroAlt} />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      {service.intro.map((p) => <p set:html={p} />)}
    </div>
  </section>

  {service.sections.map((sec, i) => (
    <section class={i % 2 === 0 ? "bg-paper" : ""}>
      <div class="wrap prose">
        <h2>{sec.h2}</h2>
        {sec.body.map((p) => <p set:html={p} />)}
        {sec.list && <ul>{sec.list.map((li) => <li set:html={li} />)}</ul>}
      </div>
    </section>
  ))}

  {service.extra && (
    <section class={service.sections.length % 2 === 0 ? "bg-paper" : ""}>
      <div class="wrap prose">
        <h2>{service.extra.h2}</h2>
        {service.extra.body.map((p) => <p set:html={p} />)}
        {service.extra.list && <ul>{service.extra.list.map((li) => <li set:html={li} />)}</ul>}
      </div>
    </section>
  )}

  <section class="bg-paper">
    <div class="wrap feature">
      <div>
        <span class="kicker">Why call a local flat-roof contractor</span>
        <h2>{service.whyHead}</h2>
        {service.why.map((p) => <p set:html={p} />)}
      </div>
      <div class="panel">
        <h3>Talk to a Local Flat-Roof Contractor</h3>
        <p>Describe your roof and the problem and get straight answers with upfront pricing. No obligation, and no pressure to buy more than the roof needs.</p>
        <a class="btn btn-call" href={site.phoneHref} style="width:100%;justify-content:center;margin-top:6px"><svg><use href="#i-phone"/></svg> Call {site.phone}</a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section>
      <div class="wrap">
        <div class="section-head"><span class="kicker">Related services</span><h2>More Dallas Flat Roofing</h2></div>
        <div class="svc-rows">
          {related.map((r) => (
            <a class="svc-row" href={`/${r.slug}/`}>
              <img src={r.img} width="360" height="172" alt={`${r.label} in Dallas, TX`} />
              <span><h3>{r.label}</h3><span class="more">View service →</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {service.faqs && service.faqs.length > 0 && (
    <section class="bg-paper">
      <div class="wrap" style="max-width:820px">
        <div class="section-head"><span class="kicker">FAQ</span><h2>{service.faqHead}</h2></div>
        <div class="faq">
          {service.faqs.map((f, i) => (
            <details open={i === 0}><summary>{f.q}</summary><div class="ans"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="callband">
    <div class="wrap">
      <h2>{service.ctaHead}</h2>
      <div class="num"><a href={site.phoneHref}>{site.phone}</a></div>
      <p>{site.hoursShort} · Dallas, TX · upfront pricing, no obligation</p>
      <div style="margin-top:18px"><a class="btn btn-ghost" href={site.phoneHref}><svg><use href="#i-phone"/></svg> Call Now</a></div>
    </div>
  </section>
</Base>
